{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revenue Entity Schema",
  "description": "Represents an invoiced revenue transaction record in the ERP financial domain.",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string",
      "description": "Unique ERP invoice identifier",
      "example": "INV-2026-NAE-88910"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "Posting date of the invoice",
      "example": "2026-08-15"
    },
    "region": {
      "type": "string",
      "description": "Commercial sales region",
      "example": "NA-East"
    },
    "territory": {
      "type": "string",
      "description": "Sub-regional territory or state",
      "example": "Southeast-ATL"
    },
    "customer_id": {
      "type": "string",
      "description": "Unique customer or distributor ID",
      "example": "CUST-DIST-901"
    },
    "sku_id": {
      "type": "string",
      "description": "Stock Keeping Unit identifier",
      "example": "SKU-8821"
    },
    "gross_amount": {
      "type": "number",
      "description": "Gross billed amount before discounts in USD",
      "example": 125000.0
    },
    "discount_amount": {
      "type": "number",
      "description": "Contractual allowances or discounts in USD",
      "example": 5000.0
    },
    "net_revenue": {
      "type": "number",
      "description": "Recognized net revenue in USD",
      "example": 120000.0
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 Currency Code",
      "example": "USD"
    },
    "posting_status": {
      "type": "string",
      "enum": ["POSTED", "PENDING", "CANCELLED"],
      "description": "Accounting status of invoice",
      "example": "POSTED"
    }
  },
  "required": [
    "invoice_id",
    "invoice_date",
    "region",
    "customer_id",
    "sku_id",
    "net_revenue",
    "posting_status"
  ]
}
