*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Python Bytecode, Caches & Wheels
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
