# ==============================================================================
# InsightPilot AI — Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the appropriate values for your environment.
# DO NOT commit real secrets, API keys, credentials, or tokens to version control.

# Application Environment (development | staging | production | test)
APP_ENV=development

# Backend API Gateway Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8080,http://127.0.0.1:5173

# Frontend Environment Variable (used by Next.js client)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Database Connection URL (PostgreSQL / SQLite fallback)
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/insightpilot
# For local development: sqlite:///data/insightpilot.db
DATABASE_URL=sqlite:///data/insightpilot.db

# ==============================================================================
# Multi-Model AI Provider Configuration (Groq + Gemini Dual Key Pools)
# ==============================================================================

# Google Gemini API Keys (Multimodal Vision, Chart Analysis, Visual Intelligence)
# Obtain keys at: https://aistudio.google.com/
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# Groq API Keys (Ultra-Fast Business Reasoning, Executive Synthesis, Persona Adaptation)
# Obtain keys at: https://console.groq.com/
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile

# AI Orchestration & Telemetry Parameters
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
AI_TEMPERATURE=0.1
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048
AI_MAX_RETRIES=1
AI_PROVIDER_FALLBACK_ENABLED=true
AI_TELEMETRY_ENABLED=true

# ==============================================================================
# Responsible AI & Safety Thresholds
# ==============================================================================
CONFIDENCE_ABSTENTION_THRESHOLD=0.65
MATERIALITY_VARIANCE_THRESHOLD=-0.03
